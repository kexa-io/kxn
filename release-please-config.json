{
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "kxn",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "crates/kxn-cli/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/kxn-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/kxn-rules/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/kxn-providers/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/kxn-mcp/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/kxn-wasm/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='kxn-cli')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='kxn-core')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='kxn-rules')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='kxn-providers')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='kxn-mcp')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='kxn-wasm')].version"
        },
        "deploy/kubernetes/kxn-watch-readonly.yaml",
        "deploy/kubernetes/kxn-pod-monitor.yaml",
        "deploy/helm/kxn-stack/values.yaml",
        { "type": "generic", "path": "deploy/helm/kxn-stack/Chart.yaml" },
        { "type": "generic", "path": "deploy/helm/kxn-monitor/Chart.yaml" },
        { "type": "generic", "path": "deploy/helm/kxn-stack/charts/kxn-monitor/Chart.yaml" },
        { "type": "generic", "path": "deploy/helm/kxn-logs/Chart.yaml" },
        { "type": "generic", "path": "docs/ai-install-prompt.md" },
        { "type": "generic", "path": "docs/alerting-and-saving.md" },
        { "type": "generic", "path": "docs/event-driven.md" },
        { "type": "generic", "path": "docs/getting-started.md" },
        { "type": "generic", "path": "docs/kubernetes-pod-monitor.md" },
        { "type": "generic", "path": "docs/kubernetes-rotation-azure.md" },
        { "type": "generic", "path": "docs/kubernetes-rotation-gcp.md" },
        { "type": "generic", "path": "docs/providers.md" },
        { "type": "generic", "path": "docs/reference.md" }
      ]
    }
  }
}
