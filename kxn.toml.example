# kxn.toml — Example configuration
#
# Copy to kxn.toml and edit with your values:
#   cp kxn.toml.example kxn.toml

[rules]
min_level = 0
# Community rules: archive URL and how often it is checked for changes.
# source = "https://github.com/kexa-io/kxn-rules/archive/refs/heads/main.tar.gz"
# refresh = "24h"

[[rules.mandatory]]
name = "ssh-cis"
path = "rules/ssh-cis.toml"

[[rules.mandatory]]
name = "http-security"
path = "rules/http-security.toml"

[[rules.mandatory]]
name = "monitoring"
path = "rules/monitoring.toml"

[[rules.optional]]
name = "postgresql-cis"
path = "rules/postgresql-cis.toml"
enabled = true

[[rules.optional]]
name = "mysql-cis"
path = "rules/mysql-cis.toml"
enabled = false

[[rules.optional]]
name = "postgresql-monitoring"
path = "rules/postgresql-monitoring.toml"
enabled = true

[[rules.optional]]
name = "mysql-monitoring"
path = "rules/mysql-monitoring.toml"
enabled = true

[[rules.optional]]
name = "cve-monitoring"
path = "rules/cve-monitoring.toml"
enabled = true

# Save scan results (optional)
# [[save]]
# type = "postgres"
# url = "postgresql://user:pass@localhost:5432/kxn"
# origin = "kxn-daemon"
# Inline retention (postgres backend): rows older than each window are pruned
# right after every save, so the database self-bounds without a cleanup cronjob.
# Durations: "30m", "48h", "7d", "2w". Unset tables are kept forever.
# Env overrides: KXN_RETENTION_{LOGS,METRICS,RESOURCES,SCANS}.
# retention = { logs = "48h", metrics = "7d", resources = "7d", scans = "30d" }

# [[save]]
# type = "elasticsearch"
# url = "elasticsearch://localhost:9200/kxn"

# [[save]]
# type = "cassandra"            # keyspace created with replication 1 when missing
# url = "cassandra://user:pass@localhost:9042/kxn"

# [[save]]
# type = "mssql"                # the database must exist; tables are created
# url = "mssql://user:pass@localhost:1433/kxn?trust_server_certificate=true"

# Targets for `kxn watch` daemon mode.
# `rules` lists rule-set names (the `name` of a [[rules.*]] entry, or the file stem
# when rules come from -R): a plain name matches as a substring, a pattern with `*`
# is an anchored glob. Omit `rules` to apply every loaded set.
[[targets]]
name = "my-server"
uri = "ssh://root@server.example.com"
rules = ["ssh-cis", "monitoring"]
interval = 300

# HTTP/TLS example — scans headers, TLS cert, security policies
[[targets]]
name = "kexa-website"
uri = "https://kexa.io"
rules = ["http-security"]
interval = 3600

# [[targets]]
# name = "my-database"
# uri = "postgresql://admin:${secret:env:DB_PASSWORD}@db.example.com:5432"   # a /dbname path is ignored
# rules = ["postgresql-cis", "postgresql-monitoring"]
# interval = 60

# Secret interpolation examples:
#   ${MY_VAR} or ${secret:env:MY_VAR}        — environment variable
#   ${secret:gcp:my-project/secret-name}     — GCP Secret Manager (application default credentials)
#   ${secret:aws:secret-name/key}            — AWS Secrets Manager (env credentials or `aws` CLI; AWS_REGION, default us-east-1)
#   ${secret:azure:vault-name/secret-name}   — Azure Key Vault (AZURE_CLIENT_ID/AZURE_CLIENT_SECRET/AZURE_TENANT_ID)
#   ${secret:vault:path/key}                 — HashiCorp Vault (VAULT_ADDR + VAULT_TOKEN, or HCP_*)
# The reference is split on the first `/`: the part before it cannot contain a `/`.
